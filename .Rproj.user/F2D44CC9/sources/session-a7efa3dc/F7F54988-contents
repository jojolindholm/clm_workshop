# **** network analysis of case law ****
# **************************************
# a hands-on introduction to r and network analysis (na)
# you will learn about: building tables; generating figures; basic na concepts:
# centrality, communities.


# prepare ----------------------------------------------------------------------

set.seed(42)   # keeps results reproducible

# load packages

library(tidyverse)   # collection of data science packages
library(igraph)      # for network analysis (ignore error msg)

# load text data

citation_edges <- read_csv("citation_edges.csv")   # references between cases
head(citation_edges)                               # glance at the variables

cases <- read_csv("cases.csv")                     # case metadata
head(cases)                                        # glance at the variables

# select anchor_case (to which we will compare other cases)

anchor_case <- "B 1064-19"   # define anchor_case as NJA 2019 s. 684 (mopedbilen)


# step 1 — build the citation graph (g) ----------------------------------------
# a network has two parts: nodes (here judgments) and edges (here citation
# from one judgment to another).

g <- graph_from_data_frame(                # graph_from_data_frame() creates a graph object                            
  citation_edges |>                        # takes the edges table
    filter(!is.na(cited_case),             # drop out-of-corpus
           cited_case != citing_case) |>   # drop self-citations
    select(citing_case, cited_case),       # keep only to-from columns
  directed = TRUE                          # citations have a direction
)

g   # glance graph object


# step 2 — create anchor case `ego` sub-graph ----------------------------------
# identify neighbors of anchor case within two degree  

anchor_case_neighbors <- neighborhood(g,             # neighborhood list nodes connect to one node 
                                      order=2,       # neighbors within one degree
                                      anchor_case)   # center on anchor_case 

ego_g <- induced_subgraph(g, anchor_case_neighbors[[1]])   # create subgraph from list

ego_g <- simplify(ego_g, edge.attr.comb = "sum")        # combine edges

plot(ego_g,
     vertex.color = ifelse(V(ego_g)$name == anchor_case, 
                           "#E8A33D", 
                           "#9FB1CC"))   # colors anchor case

## top-10 by neighbor ----------------------------------------------------------
# this approach assumes that all neighbors are equally similar 

top_10_neighbors <- V(ego_g)$name                                          # list all cases in sub-graph 
top_10_neighbors <- top_10_neighbors[!top_10_neighbors %in% anchor_case]   # remove anchor case
top_10_neighbors <- tibble(case_num = top_10_neighbors)                    # convert to table 
top_10_neighbors <- left_join(top_10_neighbors,                            # add case information from cases
                              select(cases, case_num, publ_num, court_header),
                              by = "case_num")

top_10_neighbors         # glance top-10 list 
save(top_10_neighbors,   # save top-10 list to csv file
     file = "top_10_neighbors.csv")   


# step 3 — community detection --------------------------------------------------
# grouping cases into communities or clusters based on citations. there are many
# options of clustering; we will use Louvain that is fast and standard

## detect communities ----------------------------------------------------------

g_undirected <- as_undirected(g, mode = "collapse")   # louvain requires undirected edges
communities <- cluster_louvain(g_undirected)          # cluster all cases into communities
communities                                           # glance communities

## create anchor case community sub-graph --------------------------------------

anchor_comm_id <- communities$membership[names(V(g)) == anchor_case]   # find the anchor case's community
anchor_community_g <- induced_subgraph(                                # create anchor case's community sub-graph
  g_undirected,
  V(g_undirected)[communities$membership == anchor_comm_id]
)

plot(anchor_community_g,                                               # plot anchor community's sub-graph
     vertex.size = 6,
     vertex.label.cex = 0.7,
     vertex.color = ifelse(V(anchor_community_g)$name == anchor_case,
                           "#E8A33D",                                  # anchor case is orange
                           "#9FB1CC"))                                 # other community members are blue

## top-10 by pagerank ---------------------------------------------------------
# because community membership is binary (member/non-member),  we will rank cases 
# using pagerank. pagerank is one measurement of how central cases are in the 
# network. thus, the top-10 will be the "most important" cases in the community 

pagerank <- page_rank(g, directed = TRUE)$vector                                    # calculate pagerank all nodes
top_10_community <- V(g_undirected)$name[communities$membership == anchor_comm_id]  # filter for community members
top_10_community <- top_10_community[!top_10_community %in% anchor_case]            # remove anchor case
top_10_community <- top_10_community[                                               # order by descending pagerank
  order(-pagerank[top_10_community])][1:10]                                         # keep the 10 highest
top_10_community <- tibble(case_num = top_10_community)                             # convert to table 
top_10_community <- left_join(top_10_community,                                     # add case information from cases
                              select(cases, case_num, publ_num, court_header),
                              by = "case_num")

top_10_community         # glance top-10 list 
save(top_10_community,   # save top-10 list to csv file
     file = "top_10_community.csv")   
